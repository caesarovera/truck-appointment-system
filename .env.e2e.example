APP_NAME=Laravel
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB terpisah dari dev (database/database.sqlite) supaya `migrate:fresh --seed`
# untuk e2e tak pernah menghapus data dev — lihat ADR-0005 §Kapan ditinjau ulang.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.e2e.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# log, bukan reverb — smoke test tak butuh WebSocket hidup.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync, bukan database — job (reminder dll.) langsung dieksekusi inline, tak
# butuh worker `queue:listen` nyala saat Playwright jalan.
QUEUE_CONNECTION=sync

CACHE_STORE=array

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
