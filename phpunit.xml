<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Terpisah dari Feature karena butuh trait DB yang BERBEDA: DatabaseTruncation,
             bukan RefreshDatabase (lihat tests/Pest.php). Test di sini menyalakan proses
             PHP sungguhan, jadi datanya wajib benar-benar ter-commit. -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" (audit 2026-09-16): docker-compose.yml menyetel APP_ENV=local; tanpa force
             suite di container berjalan sebagai `local` dan menulis ke storage/logs dev berlabel
             `local.` (terbukti: 1 file test = 244 baris). Ini "apakah", bukan "di mana". -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- force="true" pada baris ISOLASI di bawah (D3').
             Tanpa itu, env var yang sudah ada di environment MENANG atas berkas ini —
             dan sejak service `app` di docker-compose.yml menyetel CACHE_STORE/
             QUEUE_CONNECTION/SESSION_DRIVER=redis, seluruh suite yang dijalankan DI DALAM
             container diam-diam berhenti memakai `sync`/`array`. Akibatnya job ter-antre
             alih-alih dieksekusi inline, dan test yang mengandalkan itu berubah makna
             tanpa ada yang merah. Aturannya: environment boleh menentukan DI MANA
             (host/port DB), TIDAK boleh menentukan APAKAH test terisolasi.
             KOREKSI D6': force SENDIRIAN TIDAK CUKUP, dan klaim D3′ bahwa ia menutup
             masalah ini keliru. force hanya menulis $_ENV + putenv(); env() Laravel membaca
             $_SERVER lebih dulu, tempat nilai container masih tertanam. Yang menuntaskannya:
             tests/TestCase.php::createApplication() menyalin $_ENV ke $_SERVER. Kedua
             bagian wajib ada.
             DB_HOST/DB_PORT di bawah sengaja TANPA force — justru itu yang wajib bisa
             berbeda antara Windows (127.0.0.1:3307) dan container (mysql:3306).
             DB_DATABASE BUKAN "di mana", tapi "apakah": ia memisahkan DB test dari DB dev.
             Lihat komentar di baris DB_DATABASE. -->
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- Nilai `.env` dev (CORS_ALLOWED_ORIGINS boleh diisi) tak boleh mengubah hasil CorsTest. -->
        <env name="CORS_ALLOWED_ORIGINS" value="" force="true"/>
        <!-- SLICE D1 (ADR-0007): test jalan di MySQL sungguhan, bukan lagi sqlite :memory:.
             Alasannya BUKAN kerapian: sqlite tak menerbitkan `SELECT ... FOR UPDATE`, jadi
             test konkurensi (jantung proyek ini) mustahil jujur di atasnya. Lihat
             HANDOVER.md §Temuan 2026-09-12.
             Nilai di bawah = default yang cocok dengan docker-compose.yml. PHPUnit TIDAK
             menimpa env var yang sudah ada di environment (tanpa force="true"), jadi CI atau
             mesin dengan port lain cukup meng-export DB_HOST/DB_PORT sendiri tanpa mengubah
             file ini. Pengecualian: DB_DATABASE di-force (lihat komentarnya). -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3307"/>
        <!-- force="true" (D6'): service PHP di docker-compose.yml menyetel DB_DATABASE=tas
             (DB DEV) — dan tanpa force nilai itu menang. Akibatnya sejak D2', `pest` di dalam
             container menembak `tas`: RefreshDatabase me-migrate:fresh DB dev, dan run paralel
             menumbuhkan tas_test_N alih-alih tas_testing_test_N. Test tetap HIJAU sementara
             data dev terhapus; terbukti dengan menjalankan satu file test non-paralel di
             container (users 7 → 0). Garis D3' di atas ditarik di tempat yang salah untuk baris
             ini. Nilainya sama di semua jalur (native, container, CI), jadi force tak
             mengambil fleksibilitas apa pun. Seperti baris isolasi lain, force ini baru
             berefek bersama tests/TestCase.php (lihat koreksi di atas). -->
        <env name="DB_DATABASE" value="tas_testing" force="true"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <!-- DB Redis khusus test. Test yang memang menguji Redis (RedisUniqueJobTest)
             meng-FLUSH database ini; tanpa pemisahan, ia akan menghapus cache & antrian
             DEV yang berbagi container Redis yang sama. Pola sama dengan `tas_testing`
             yang dipisah dari `tas`. -->
        <env name="REDIS_DB" value="15" force="true"/>
        <env name="REDIS_CACHE_DB" value="15" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
