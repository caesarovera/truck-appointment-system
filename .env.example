APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# CORS: kosong = tak ada akses lintas-origin (SPA same-origin). Isi hanya bila SPA di domain
# terpisah, dipisah koma: https://tas.example.com. Jangan `*`.
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB / SESSION / BROADCAST / QUEUE / CACHE / REDIS di bawah = nilai jalur NATIVE (`composer dev`,
# SQLite). Di Docker (jalur utama) semuanya DITIMPA env var di docker-compose.yml (MySQL `tas`,
# Redis, Reverb) — jangan diubah di sini untuk Docker. Test tak memakai keduanya: phpunit.xml.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Native saja: `log` (tanpa push live). Docker memakai `reverb` lewat docker-compose.yml.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reverb (WebSocket realtime). Nilai KHUSUS DEV LOKAL — service `reverb` di docker compose
# langsung jalan dengan ini. KENAPA tidak kosong: compose memaksa BROADCAST_CONNECTION=reverb,
# dan dengan kunci kosong SETIAP job broadcast gagal di Horizon ("Pusher error: Not found")
# sementara booking tetap 201 — realtime mati tanpa pesan (terbukti dari clone kosong,
# 2026-09-14). `php artisan reverb:install` BUKAN solusinya: ia tak mengisi kunci yang sudah
# ada walau kosong, dan ikut mengubah config proyek. Preseden kredensial dev ter-commit:
# password MySQL `secret` di docker-compose.yml & phpunit.xml.
# PRODUKSI: WAJIB ganti ketiganya dengan nilai acak.
# REVERB_HOST di sini dipakai BROWSER (lewat VITE_REVERB_HOST); PHP di container memakai
# `reverb` dari docker-compose.yml.
REVERB_APP_ID=100001
REVERB_APP_KEY=tas-local-dev-key
REVERB_APP_SECRET=tas-local-dev-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# HOST (bukan URL) halaman SPA yang boleh membuka WebSocket, dipisah koma; wildcard
# `*.example.com` boleh. Kosong = host APP_URL (dev: localhost). Entri `*`/`*example.com`
# DIABAIKAN (bukan membuka semua) — hanya awalan `*.` utuh yang sah.
REVERB_ALLOWED_ORIGINS=

# Strict-Transport-Security (detik), hanya dikirim lewat HTTPS. 0 = mati.
TAS_HSTS_MAX_AGE=31536000

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
